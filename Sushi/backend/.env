# Copia este archivo como .env y llena los valores. NUNCA subas .env a git.
FLASK_ENV=development
FLASK_DEBUG=0

# Base de datos (usa un usuario propio de la app, no root)
DB_HOST=localhost
DB_PORT=3306
DB_USER=hanami_app
DB_PASSWORD=cambia_esto
DB_NAME=hanami_v2

# Firma de tokens JWT. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia_esto_por_un_valor_largo_y_aleatorio
JWT_HORAS=8

# Orígenes permitidos (separados por coma). En dev: el servidor de Angular.
CORS_ORIGINS=http://localhost:4200

# Contraseña inicial de las cuentas demo que crea database/seed.py
SEED_PASSWORD=Hanami2026!
